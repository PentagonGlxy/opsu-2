--- a/src/itdelatrisu/opsu/objects/Circle.java
+++ b/src/itdelatrisu/opsu/objects/Circle.java
@@ -137,8 +137,7 @@
 		else if (timeDiff <= hitResultOffset[GameData.HIT_50])
 			result = GameData.HIT_50;
-		else if (timeDiff <= hitResultOffset[GameData.HIT_MISS])
-			result = GameData.HIT_MISS;
-		//else not a hit
+		// osu!stable has no "early miss" window: a press landing outside the 50
+		// window is discarded (the circle only shakes), so leave the result at -1.
 
 		return result;
 	}
