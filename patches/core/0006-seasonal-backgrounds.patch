+	/**
+	 * Applies changes to the seasonal background option without requiring a restart.
+	 */
+	private void syncSeasonalBackgroundState() {
+		boolean enabled = Options.areSeasonalBackgroundsEnabled();
+		if (enabled) {
+			if (!seasonalBackgroundsEnabled || !seasonalBackgroundLoadAttempted) {
+				selectNextSeasonalBackground();
+				bgAlpha.setTime(0);
+			}
+		} else if (seasonalBackgroundsEnabled) {
+			releaseSeasonalBackground();
+			seasonalBackgroundLoadAttempted = false;
+		}
+		seasonalBackgroundsEnabled = enabled;
+	}
+
+	/**
+	 * Selects and loads another image from the seasonal background directory.
+	 * Only the selected image is kept in memory, so the directory has no hard image-count limit.
+	 * @return true if an image was loaded
+	 */
+	private boolean selectNextSeasonalBackground() {
+		seasonalBackgroundLoadAttempted = true;
+		File[] files = Options.getSeasonalBackgroundDir().listFiles();
+		if (files == null || files.length == 0) {
+			releaseSeasonalBackground();
+			return false;
+		}
+
+		List<File> images = new ArrayList<File>();
+		for (File file : files) {
+			if (!file.isFile())
+				continue;
+			String name = file.getName().toLowerCase(Locale.ROOT);
+			if (name.endsWith(".png") || name.endsWith(".jpg") ||
+			    name.endsWith(".jpeg") || name.endsWith(".bmp"))
+				images.add(file);
+		}
+		if (images.isEmpty()) {
+			releaseSeasonalBackground();
+			return false;
+		}
+
+		int index = (int) (Math.random() * images.size());
+		File nextFile = images.get(index);
+		if (images.size() > 1 && seasonalBackgroundFile != null &&
+		    nextFile.getAbsolutePath().equals(seasonalBackgroundFile.getAbsolutePath()))
+			nextFile = images.get((index + 1) % images.size());
+
+		try {
+			Image nextBackground = new Image(nextFile.getAbsolutePath());
+			releaseSeasonalBackground();
+			seasonalBackground = nextBackground;
+			seasonalBackgroundFile = nextFile;
+			return true;
+		} catch (SlickException e) {
+			Log.warn(String.format("Failed to load seasonal background image '%s'.", nextFile), e);
+			releaseSeasonalBackground();
+			return false;
+		}
+	}
+
+	/** Releases the current seasonal background image. */
+	private void releaseSeasonalBackground() {
+		if (seasonalBackground != null && !seasonalBackground.isDestroyed()) {
+			try {
+				seasonalBackground.destroy();
+			} catch (SlickException e) {
+				Log.warn("Failed to release seasonal background image.", e);
+			}
+		}
+		seasonalBackground = null;
+		seasonalBackgroundFile = null;
+	}
+
+	/**
+	 * Draws the current seasonal background, filling the screen while preserving aspect ratio.
+	 * @return true if a seasonal background was drawn
+	 */
+	private boolean drawSeasonalBackground(
+		int width, int height, float offsetX, float offsetY, float alpha
+	) {
+		if (!Options.areSeasonalBackgroundsEnabled() || seasonalBackground == null)
+			return false;
+
+		int imageWidth = seasonalBackground.getWidth();
+		int imageHeight = seasonalBackground.getHeight();
+		if (imageWidth <= 0 || imageHeight <= 0)
+			return false;
+
+		float scale = Math.max(width / (float) imageWidth, height / (float) imageHeight);
+		if (Options.isParallaxEnabled())
+			scale *= GameImage.PARALLAX_SCALE;
+		float drawWidth = imageWidth * scale;
+		float drawHeight = imageHeight * scale;
+		seasonalBackground.setAlpha(alpha);
+		seasonalBackground.draw(
+			(width - drawWidth) / 2f + offsetX,
+			(height - drawHeight) / 2f + offsetY,
+			drawWidth,
+			drawHeight
+		);
+		return true;
+	}
