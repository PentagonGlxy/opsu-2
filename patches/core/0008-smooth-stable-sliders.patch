 	public abstract Vec2f pointAt(float t);
 
 	/**
+	 * Returns a stable tangent along the curve.
+	 * A centered sample avoids the rotation jitter caused by looking only ahead
+	 * from the slider ball, especially near repeats and the curve endpoint.
+	 * @param t the position on the curve [0, 1]
+	 * @return a direction vector following the curve
+	 */
+	public Vec2f tangentAt(float t) {
+		if (curve == null || curve.length < 2)
+			return new Vec2f(1f, 0f);
+
+		t = Utils.clamp(t, 0f, 1f);
+		float sample = Math.min(0.02f, Math.max(0.005f, 2f / (curve.length - 1)));
+		float from = Math.max(0f, t - sample);
+		float to = Math.min(1f, t + sample);
+		Vec2f tangent = pointAt(to).sub(pointAt(from));
+		if (tangent.len() < 0.001f) {
+			from = Math.max(0f, t - 0.05f);
+			to = Math.min(1f, t + 0.05f);
+			tangent = pointAt(to).sub(pointAt(from));
+		}
+		return (tangent.len() < 0.001f) ? new Vec2f(1f, 0f) : tangent;
+	}
+
