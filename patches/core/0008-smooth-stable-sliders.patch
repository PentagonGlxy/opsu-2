 	/**
+	 * Returns the skin animation frame for an elapsed time.
+	 * Skin.ini's AnimationFramerate is honored; otherwise one full cycle plays each second.
+	 */
+	private Image getAnimationFrame(Image[] frames, float elapsed) {
+		if (frames.length == 1)
+			return frames[0];
+		int fps = Options.getSkin().getAnimationFramerate();
+		if (fps <= 0)
+			fps = frames.length;
+		int frame = (int) (Math.max(0f, elapsed) * fps / 1000f) % frames.length;
+		return frames[frame];
+	}
+
+	/**
+	 * Returns a sub-millisecond render position when it matches the gameplay clock.
+	 * The supplied position remains authoritative while paused, seeking, or failing.
+	 */
+	private float getRenderPosition(int trackPosition) {
+		if (!Options.isSmoothSliderEnabled())
+			return trackPosition;
+		float precisePosition = MusicController.getPrecisePosition(true) - Options.getRenderOffset();
+		return (Math.abs(precisePosition - trackPosition) < 50f) ?
+				precisePosition : trackPosition;
+	}
