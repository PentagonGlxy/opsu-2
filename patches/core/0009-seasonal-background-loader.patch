 a/src/itdelatrisu/opsu/ui/SeasonalBackground.java | 208 ++++++++++++++++++
 1 file changed, 208 insertions(+)

diff --git a/src/itdelatrisu/opsu/ui/SeasonalBackground.java b/src/itdelatrisu/opsu/ui/SeasonalBackground.java
new file mode 100644
--- /dev/null
+++ b/src/itdelatrisu/opsu/ui/SeasonalBackground.java
