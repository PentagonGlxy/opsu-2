+package itdelatrisu.opsu.downloads.servers;
+
+import fluddokt.opsu.fake.Log;
+import itdelatrisu.opsu.ErrorHandler;
+import itdelatrisu.opsu.Utils;
+import itdelatrisu.opsu.downloads.DownloadNode;
+
+import java.io.IOException;
+import java.io.UnsupportedEncodingException;
+import java.net.MalformedURLException;
+import java.net.URL;
+import java.net.URLEncoder;
+
+import org.json.JSONArray;
+import org.json.JSONException;
+import org.json.JSONObject;
+
+/**
+ * Download server backed by a CheeseGull-compatible beatmap mirror.
+ *
+ * CheeseGull's search format is shared by modern mirrors including Mino,
+ * osu.direct, and Hinai, so one implementation keeps their pagination and
+ * metadata handling consistent.
+ */
+public class CheeseGullServer extends DownloadServer {
+	/** Maximum beatmaps displayed per page. */
+	private static final int PAGE_LIMIT = 20;
+
+	/** Server display name. */
+	private final String serverName;
+
+	/** Search endpoint without query parameters. */
+	private final String searchEndpoint;
+
+	/** Formatted download URL: {@code beatmapSetID}. */
+	private final String downloadURL;
+
+	/** Total result count from the last query. */
+	private int totalResults = -1;
+
+	/**
+	 * Constructor.
+	 * @param serverName the name shown in the downloads menu
+	 * @param searchEndpoint the CheeseGull-compatible search endpoint
+	 * @param downloadURL the formatted direct download URL
+	 */
+	public CheeseGullServer(String serverName, String searchEndpoint, String downloadURL) {
+		this.serverName = serverName;
+		this.searchEndpoint = searchEndpoint;
+		this.downloadURL = downloadURL;
+	}
+
+	@Override
+	public String getName() { return serverName; }
+
+	@Override
+	public String getDownloadURL(int beatmapSetID) {
+		return String.format(downloadURL, beatmapSetID);
+	}
+
+	@Override
+	public DownloadNode[] resultList(String query, int page, boolean rankedOnly) throws IOException {
+		DownloadNode[] nodes = null;
+		try {
+			int offset = (page - 1) * PAGE_LIMIT;
+			String search = String.format(
+				"%s?query=%s&mode=0&amount=%d&offset=%d",
+				searchEndpoint,
+				URLEncoder.encode(query, "UTF-8"),
+				PAGE_LIMIT,
+				offset
+			);
+			if (rankedOnly)
+				search += "&status=1";
+
+			JSONArray results = Utils.readJsonArrayFromUrl(new URL(search));
+			if (results == null) {
+				totalResults = -1;
+				return null;
+			}
+
+			nodes = new DownloadNode[results.length()];
+			for (int i = 0; i < nodes.length; i++) {
+				JSONObject item = results.getJSONObject(i);
+				nodes[i] = new DownloadNode(
+					item.getInt("SetID"),
+					optionalString(item, "LastUpdate", "?"),
+					item.getString("Title"),
+					optionalString(item, "TitleUnicode", null),
+					item.getString("Artist"),
+					optionalString(item, "ArtistUnicode", null),
+					item.getString("Creator")
+				);
+			}
+
+			// CheeseGull does not expose a full count. Keep the next-page
+			// button available while a complete page is returned.
+			totalResults = offset + nodes.length;
+			if (nodes.length == PAGE_LIMIT)
+				totalResults++;
+		} catch (MalformedURLException | UnsupportedEncodingException e) {
+			ErrorHandler.error(String.format(
+				"Problem loading %s result list for query '%s'.",
+				serverName, query
+			), e, true);
+		} catch (JSONException e) {
+			Log.error(e);
+		}
+		return nodes;
+	}
+
+	/**
+	 * Returns an optional JSON string without turning JSON null into "null".
+	 */
+	private String optionalString(JSONObject item, String key, String fallback) {
+		if (!item.has(key) || item.isNull(key))
+			return fallback;
+		String value = item.optString(key, fallback);
+		return (value == null || value.length() == 0) ? fallback : value;
+	}
+
+	@Override
+	public int minQueryLength() { return 0; }
+
+	@Override
+	public int totalResults() { return totalResults; }
+}
