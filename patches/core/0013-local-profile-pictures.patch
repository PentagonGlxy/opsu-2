+
+package itdelatrisu.opsu.user;
+
+import fluddokt.opsu.fake.File;
+import fluddokt.opsu.fake.Image;
+import fluddokt.opsu.fake.SlickException;
+
+import itdelatrisu.opsu.options.Options;
+
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Loads and caches per-user profile pictures stored entirely on the device.
+ */
+public final class UserProfilePictures {
+	/** User-visible directory containing local profile pictures. */
+	private static final File DIRECTORY = new File(Options.DATA_DIR, "profilepictures/");
+
+	/** Loaded profile pictures, keyed by case-insensitive user name. */
+	private static final Map<String, Image> images = new HashMap<String, Image>();
+
+	private UserProfilePictures() {}
+
+	/** Returns the local profile picture for a user, or {@code null}. */
+	public static Image getImage(User user) {
+		if (user == null)
+			return null;
+
+		String key = getKey(user.getName());
+		if (images.containsKey(key))
+			return images.get(key);
+
+		File file = getFile(user.getName());
+		if (!file.isFile()) {
+			// Cache the absence too: menu user buttons are refreshed every frame.
+			images.put(key, null);
+			return null;
+		}
+
+		try {
+			Image image = new Image(file.getAbsolutePath());
+			images.put(key, image);
+			return image;
+		} catch (SlickException e) {
+			return null;
+		}
+	}
+
+	/** Returns whether a user has a local profile picture. */
+	public static boolean hasImage(String userName) {
+		return getFile(userName).isFile();
+	}
+
+	/** Returns the canonical destination used by the platform image picker. */
+	public static String getDestinationPath(String userName) {
+		ensureDirectory();
+		return getFile(userName).getAbsolutePath();
+	}
+
+	/** Invalidates a cached image after the platform replaces its local file. */
+	public static void invalidate(String userName) {
+		Image image = images.remove(getKey(userName));
+		if (image != null) {
+			try {
+				image.destroy();
+			} catch (SlickException ignored) {
+			}
+		}
+	}
+
+	/** Deletes a user's local profile picture and releases its texture. */
+	public static void delete(String userName) {
+		invalidate(userName);
+		File file = getFile(userName);
+		if (file.isFile())
+			file.delete();
+	}
+
+	/** Returns the user-visible local profile-picture directory. */
+	public static String getDirectoryPath() {
+		ensureDirectory();
+		return DIRECTORY.getAbsolutePath();
+	}
+
+	private static File getFile(String userName) {
+		return new File(DIRECTORY, getFileName(userName));
+	}
+
+	private static void ensureDirectory() {
+		if (!DIRECTORY.isDirectory())
+			DIRECTORY.mkdir();
+	}
+
+	private static String getKey(String userName) {
+		return userName.toLowerCase(Locale.ROOT);
+	}
+
+	/**
+	 * Produces a readable, traversal-safe file name.  The hash suffix prevents
+	 * collisions between names whose punctuation normalizes to underscores.
+	 */
+	private static String getFileName(String userName) {
+		String lowerName = getKey(userName);
+		StringBuilder safeName = new StringBuilder();
+		for (int i = 0; i < lowerName.length(); i++) {
+			char c = lowerName.charAt(i);
+			if ((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') ||
+				c == '-' || c == '_')
+				safeName.append(c);
+			else
+				safeName.append('_');
+		}
+		if (safeName.length() == 0)
+			safeName.append("user");
+		return safeName.toString() + "-" + Integer.toHexString(lowerName.hashCode()) + ".png";
+	}
+}
