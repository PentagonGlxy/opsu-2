@@ -0,0 +1,49 @@
+package fluddokt.ex;
+
+/**
+ * Platform bridge for selecting a local profile picture.
+ */
+public class ProfilePicturePicker {
+	public static ProfilePicturePicker info = new ProfilePicturePicker();
+
+	private String updatedUser;
+	private String error;
+
+	/** Returns whether the current platform provides a native image picker. */
+	public boolean isAvailable() {
+		return false;
+	}
+
+	/**
+	 * Opens the platform image picker.
+	 * @param userName user receiving the profile picture
+	 * @param destinationPath canonical local destination managed by the core
+	 */
+	public void chooseProfilePicture(String userName, String destinationPath) {
+	}
+
+	/** Returns and clears the most recently updated user name. */
+	public synchronized String consumeUpdatedUser() {
+		String result = updatedUser;
+		updatedUser = null;
+		return result;
+	}
+
+	/** Returns and clears the most recent picker error. */
+	public synchronized String consumeError() {
+		String result = error;
+		error = null;
+		return result;
+	}
+
+	/** Notifies the shared core that a profile picture was saved. */
+	protected synchronized void notifyProfilePictureSaved(String userName) {
+		updatedUser = userName;
+		error = null;
+	}
+
+	/** Notifies the shared core that a profile picture could not be saved. */
+	protected synchronized void notifyProfilePictureError(String message) {
+		error = message;
+	}
+}
