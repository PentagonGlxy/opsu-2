+			float outro = Utils.clamp(
+				(WELCOME_ANIMATION_DURATION - welcomeAnimationTime) / 900f, 0f, 1f
+			);
+			float alpha = Math.min(intro, outro);
+			stableOverlayColor.a = (1f - intro) * 0.72f;
+			g.setColor(stableOverlayColor);
+			g.fillRect(0, 0, width, height);
+			drawCenteredStableText(
+				"welcome to osu!", height * 0.77f, alpha, width
+			);
+		} else if (exiting) {
+			float progress = Utils.clamp(
+				(float) exitAnimationTime / EXIT_ANIMATION_DURATION, 0f, 1f
+			);
+			float captionIn = Utils.clamp(exitAnimationTime / 240f, 0f, 1f);
+			float captionOut = Utils.clamp(
+				(EXIT_ANIMATION_DURATION - exitAnimationTime) / 420f, 0f, 1f
