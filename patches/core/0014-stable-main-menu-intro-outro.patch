+	/** Returns the current visibility of the stable-style ribbon menu. */
+	private float getStableMenuVisibility() {
+		switch (logoState) {
+		case OPENING:
+			return Utils.clamp(
+				(float) logoOpen.getTime() / logoOpen.getDuration(), 0f, 1f
+			);
+		case OPEN:
+		case CLOSING:
+			return Utils.clamp(logoButtonAlpha.getValue(), 0f, 1f);
+		case DEFAULT:
+		default:
+			return 0f;
+		}
+	}
+
+	/** Lays out the four stable-style menu ribbons for the current screen size. */
+	private void layoutStableMenu(int width, int height) {
+		float visibility = getStableMenuVisibility();
+		float ribbonX = width * 0.47f + (1f - visibility) * width * 0.12f;
+		float ribbonWidth = Math.min(width * 0.40f, width - ribbonX - width * 0.025f);
+		float ribbonHeight = Math.max(46f, height * 0.095f);
+		float gap = Math.max(8f, height * 0.014f);
+		float firstY = height * 0.245f;
+
+		for (int i = 0; i < stableMenuRects.length; i++) {
+			float hoverOffset = stableMenuHover[i] * width * 0.009f;
+			stableMenuRects[i].set(
+				ribbonX + hoverOffset,
+				firstY + i * (ribbonHeight + gap),
+				Math.max(1f, ribbonWidth - hoverOffset),
+				ribbonHeight
+			);
+		}
+	}
+
+	/** Draws the responsive purple menu ribbons used by osu!stable. */
+	private void drawStableMenu(Graphics g, int width, int height) {
+		float visibility = getStableMenuVisibility();
+		if (visibility <= 0f)
+			return;
+
+		layoutStableMenu(width, height);
+		float oldBaseAlpha = stableMenuBase.a;
+		float oldAccentAlpha = stableMenuAccent.a;
+		float oldHoverAlpha = stableMenuHoverColor.a;
+		float oldTextAlpha = stableMenuText.a;
+		float stripWidth = Math.max(5f, width * 0.008f);
+
+		for (int i = 0; i < stableMenuRects.length; i++) {
+			Rectangle rect = stableMenuRects[i];
+			stableMenuBase.a = (0.76f + i * 0.025f) * visibility;
+			g.setColor(stableMenuBase);
+			g.fillRect(rect.getX(), rect.getY(), rect.getWidth(), rect.getHeight());
+
+			stableMenuAccent.a = 0.92f * visibility;
+			g.setColor(stableMenuAccent);
+			g.fillRect(rect.getX(), rect.getY(), stripWidth, rect.getHeight());
+			g.fillRect(
+				rect.getX() + rect.getWidth() - stripWidth * 0.65f,
+				rect.getY(), stripWidth * 0.65f, rect.getHeight()
+			);
+
+			if (stableMenuHover[i] > 0f) {
+				stableMenuHoverColor.a = 0.55f * stableMenuHover[i] * visibility;
+				g.setColor(stableMenuHoverColor);
+				g.fillRect(rect.getX(), rect.getY(), rect.getWidth(), rect.getHeight());
+			}
+
+			stableMenuText.a = visibility;
+			float labelY = rect.getY() + (rect.getHeight() - Fonts.LARGE.getLineHeight()) / 2f;
+			Fonts.LARGE.drawString(
+				rect.getX() + width * 0.028f,
+				labelY,
+				STABLE_MENU_LABELS[i],
+				stableMenuText
+			);
+
+			float hintWidth = Fonts.SMALL.getWidth(STABLE_MENU_HINTS[i]);
+			float hintY = rect.getY() + (rect.getHeight() - Fonts.SMALL.getLineHeight()) / 2f;
+			Fonts.SMALL.drawString(
+				rect.getX() + rect.getWidth() - hintWidth - width * 0.024f,
+				hintY,
+				STABLE_MENU_HINTS[i],
+				stableMenuText
+			);
+		}
+
+		stableMenuBase.a = oldBaseAlpha;
+		stableMenuAccent.a = oldAccentAlpha;
+		stableMenuHoverColor.a = oldHoverAlpha;
+		stableMenuText.a = oldTextAlpha;
+	}
+
+	/** Draws an inexpensive beat-reactive radial spectrum behind the logo. */
+	private void drawStableSpectrum(Graphics g, int width, int height, float beatProgress) {
+		float size = Math.min(width, height);
+		float centerX = logo.getX();
+		float centerY = logo.getY();
+		float innerRadius = size * 0.285f;
+		float pulse = 1f - Math.abs(beatProgress * 2f - 1f);
+		float phase = System.currentTimeMillis() % 1800L / 900f;
+		float oldAlpha = stableSpectrumColor.a;
+
+		stableSpectrumColor.a = 0.34f + pulse * 0.16f;
+		g.setColor(stableSpectrumColor);
+		g.setLineWidth(Math.max(1f, height / 540f));
+		for (int i = 0; i < STABLE_SPECTRUM_SAMPLES; i++) {
+			float wavePhase = (i * 0.381966f + phase) % 2f;
+			float wave = 1f - Math.abs(wavePhase - 1f);
+			float outerRadius = innerRadius + size * (0.018f + wave * 0.045f + pulse * 0.018f);
+			float cos = STABLE_SPECTRUM_COS[i];
+			float sin = STABLE_SPECTRUM_SIN[i];
+			g.drawLine(
+				centerX + cos * innerRadius,
+				centerY + sin * innerRadius,
+				centerX + cos * outerRadius,
+				centerY + sin * outerRadius
+			);
+		}
+		g.resetLineWidth();
+		stableSpectrumColor.a = oldAlpha;
+	}
+
