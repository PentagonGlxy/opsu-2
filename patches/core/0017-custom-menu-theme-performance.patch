diff --git a/src/fluddokt/ex/MenuThemePicker.java b/src/fluddokt/ex/MenuThemePicker.java
new file mode 100644
index 00000000..ca304f01
--- /dev/null
+++ b/src/fluddokt/ex/MenuThemePicker.java
@@ -0,0 +1,101 @@
+package fluddokt.ex;
+
+/**
+ * Platform bridge for importing a custom main-menu theme.
+ *
+ * <p>Android supplies a native document picker while the shared core polls for
+ * completed selections.  Keeping the picker behind this bridge avoids Android
+ * dependencies in the core module.</p>
+ */
+public class MenuThemePicker {
+	public static MenuThemePicker info = new MenuThemePicker();
+
+	/** Immutable result returned by a platform theme importer. */
+	public static final class Selection {
+		public final String path;
+		public final String title;
+		public final String artist;
+		public final int duration;
+		public final String timingPoint;
+
+		public Selection(
+			String path,
+			String title,
+			String artist,
+			int duration,
+			String timingPoint
+		) {
+			this.path = path;
+			this.title = title;
+			this.artist = artist;
+			this.duration = duration;
+			this.timingPoint = timingPoint;
+		}
+	}
+
+	private Selection selection;
+	private String error;
+	private boolean resetRequested;
+
+	/** Returns whether the current platform provides a native theme picker. */
+	public boolean isAvailable() {
+		return false;
+	}
+
+	/**
+	 * Opens the platform theme picker.
+	 *
+	 * @param currentTitle current custom title, if any
+	 * @param currentArtist current custom artist, if any
+	 * @param destinationDirectory core-managed theme directory
+	 */
+	public void chooseMenuTheme(
+		String currentTitle,
+		String currentArtist,
+		String destinationDirectory
+	) {
+	}
+
+	/** Requests that the core return to the built-in menu theme. */
+	public synchronized void requestReset() {
+		resetRequested = true;
+	}
+
+	/** Returns and clears the most recently imported theme. */
+	public synchronized Selection consumeSelection() {
+		Selection result = selection;
+		selection = null;
+		return result;
+	}
+
+	/** Returns and clears the most recent importer error. */
+	public synchronized String consumeError() {
+		String result = error;
+		error = null;
+		return result;
+	}
+
+	/** Returns and clears a pending reset request. */
+	public synchronized boolean consumeResetRequested() {
+		boolean result = resetRequested;
+		resetRequested = false;
+		return result;
+	}
+
+	/** Notifies the shared core that a theme was installed. */
+	protected synchronized void notifyThemeSelected(
+		String path,
+		String title,
+		String artist,
+		int duration,
+		String timingPoint
+	) {
+		selection = new Selection(path, title, artist, duration, timingPoint);
+		error = null;
+	}
+
+	/** Notifies the shared core that a theme could not be imported. */
+	protected synchronized void notifyThemeError(String message) {
+		error = message;
+	}
+}
