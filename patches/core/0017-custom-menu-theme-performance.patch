+				Options.saveOptions();
+				MusicController.reset();
+				MusicController.playThemeSong();
+				lastMeasureProgress = 0f;
+				musicInfoProgress.setTime(0);
+				UI.getNotificationManager().sendBarNotification(
+					String.format("Menu theme: %s - %s", selection.artist, selection.title)
+				);
+			} else {
+				UI.getNotificationManager().sendBarNotification("The imported menu theme could not be activated.");
+			}
+		}
+
+		if (MenuThemePicker.info.consumeResetRequested()) {
+			Options.resetCustomMenuTheme();
+			Options.saveOptions();
+			MusicController.reset();
+			MusicController.playThemeSong();
+			lastMeasureProgress = 0f;
+			musicInfoProgress.setTime(0);
+			UI.getNotificationManager().sendBarNotification("Restored the built-in menu theme.");
+		}
+
+		String pickerError = MenuThemePicker.info.consumeError();
+		if (pickerError != null)
+			UI.getNotificationManager().sendBarNotification(pickerError);
+	}
+
+	/** Refreshes status text once per second instead of allocating it every frame. */
+	private void updateStableStatusText() {
+		long now = System.currentTimeMillis();
+		if (now < nextStatusTextUpdate)
+			return;
+		nextStatusTextUpdate = now + 1000L;
+		beatmapStatusText = String.format(
+			"You have %d beatmaps available!",
+			BeatmapSetList.get().getMapCount()
+		);
+		runTimeStatusText = String.format(
+			"%s has been running for %s.",
+			OpsuConstants.PROJECT_NAME,
+			Utils.getTimeString((int) (now - programStartTime) / 1000)
+		);
+		menuClockDate.setTime(now);
+		clockStatusText = String.format("It is currently %s.", menuClockFormat.format(menuClockDate));
+	}
+
+	/** Draws one rotating stable-style footer tip without per-frame string creation. */
+	private void drawStableMenuTip(int width, int height) {
+		int index = (int) ((System.currentTimeMillis() / MENU_TIP_INTERVAL) % STABLE_MENU_TIPS.length);
+		String tip = STABLE_MENU_TIPS[index];
+		float x = Math.max(8f, (width - Fonts.DEFAULT.getWidth(tip)) / 2f);
+		float y = height * 0.91f;
+		Fonts.DEFAULT.drawString(x + 1f, y + 1f, tip, Colors.BLACK_ALPHA);
+		Fonts.DEFAULT.drawString(x, y, tip, Colors.WHITE_FADE);
+	}
+
