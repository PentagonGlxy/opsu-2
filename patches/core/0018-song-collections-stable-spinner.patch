+package itdelatrisu.opsu.beatmap;
+
+import fluddokt.opsu.fake.File;
+
+import itdelatrisu.opsu.ErrorHandler;
+import itdelatrisu.opsu.options.Options;
+
+import java.io.BufferedReader;
+import java.io.BufferedWriter;
+import java.io.IOException;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.Locale;
+import java.util.Map;
+
+/**
+ * Persistent, device-local beatmap collections.
+ *
+ * Collections intentionally use a compact text format instead of the osu!
+ * client database format.  This keeps the Android revival independent from
+ * an installed osu! client while still giving maps stable identities across
+ * rescans.
+ */
+public final class BeatmapCollections {
+	/** Managed collection file inside the opsu! user-data directory. */
+	private static final File COLLECTION_FILE = new File(Options.DATA_DIR, ".opsu_collections");
+
+	/** Defensive limits for a user-editable local file. */
+	private static final int MAX_COLLECTIONS = 128, MAX_MEMBERSHIPS = 100000;
+
+	/** Collection name to ordered set of beatmap-set keys. */
+	private static final LinkedHashMap<String, LinkedHashSet<String>> collections =
+			new LinkedHashMap<String, LinkedHashSet<String>>();
+
+	/** Whether the collection file has been loaded. */
+	private static boolean loaded;
+
+	/** Currently selected collection, or {@code null}. */
+	private static String selectedName;
+
+	private BeatmapCollections() {}
+
+	/** Loads the collection file once. */
+	private static synchronized void load() {
+		if (loaded)
+			return;
+		loaded = true;
+		if (!COLLECTION_FILE.isFile() || COLLECTION_FILE.length() > 4 * 1024 * 1024)
+			return;
+
+		int memberships = 0;
+		try (BufferedReader reader = COLLECTION_FILE.reader(8192, "UTF-8")) {
+			String line;
+			while ((line = reader.readLine()) != null) {
+				if (line.isEmpty() || line.charAt(0) == '#')
+					continue;
+				String[] fields = line.split("\\t", -1);
+				if (fields.length < 2)
+					continue;
+				if ("S".equals(fields[0])) {
+					selectedName = cleanName(fields[1]);
+				} else if ("C".equals(fields[0]) && collections.size() < MAX_COLLECTIONS) {
+					String name = cleanName(fields[1]);
+					if (!name.isEmpty() && findCanonicalName(name) == null)
+						collections.put(name, new LinkedHashSet<String>());
+				} else if ("M".equals(fields[0]) && fields.length >= 3 && memberships < MAX_MEMBERSHIPS) {
+					String name = findCanonicalName(cleanName(fields[1]));
+					String key = fields[2].trim();
+					if (name != null && !key.isEmpty()) {
+						collections.get(name).add(key);
+						memberships++;
+					}
+				}
+			}
+		} catch (Exception e) {
+			collections.clear();
+			selectedName = null;
+			ErrorHandler.error("Could not load beatmap collections.", e, false);
+		}
+
+		selectedName = findCanonicalName(selectedName);
+		if (selectedName == null && !collections.isEmpty())
+			selectedName = collections.keySet().iterator().next();
+	}
+
+	/** Saves all collection data. */
+	private static synchronized boolean save() {
+		load();
+		Options.DATA_DIR.mkdir();
+		try (BufferedWriter writer = COLLECTION_FILE.writer("UTF-8")) {
+			writer.write("# opsu! Android collections v1");
+			writer.newLine();
+			if (selectedName != null) {
+				writer.write("S\t");
+				writer.write(selectedName);
+				writer.newLine();
+			}
+			for (Map.Entry<String, LinkedHashSet<String>> entry : collections.entrySet()) {
+				writer.write("C\t");
+				writer.write(entry.getKey());
+				writer.newLine();
+				for (String key : entry.getValue()) {
+					writer.write("M\t");
+					writer.write(entry.getKey());
+					writer.write('\t');
+					writer.write(key);
+					writer.newLine();
+				}
+			}
+			return true;
+		} catch (IOException e) {
+			ErrorHandler.error("Could not save beatmap collections.", e, false);
+			return false;
+		}
+	}
+
+	/** Cleans user-entered names for the line-oriented storage format. */
+	private static String cleanName(String name) {
+		if (name == null)
+			return "";
+		name = name.replace('\t', ' ').replace('\r', ' ').replace('\n', ' ').trim();
+		while (name.contains("  "))
+			name = name.replace("  ", " ");
+		return (name.length() > 40) ? name.substring(0, 40).trim() : name;
+	}
+
+	/** Returns the stored spelling for a collection name. */
+	private static String findCanonicalName(String name) {
+		if (name == null)
+			return null;
+		String lower = name.toLowerCase(Locale.ROOT);
+		for (String storedName : collections.keySet()) {
+			if (storedName.toLowerCase(Locale.ROOT).equals(lower))
+				return storedName;
+		}
+		return null;
+	}
+
+	/** Builds a stable local key for a beatmap set. */
+	private static String getSetKey(BeatmapSet set) {
+		if (set == null || set.size() == 0)
+			return "";
+		Beatmap map = set.get(0);
+		if (map.beatmapSetID > 0)
+			return "s:" + map.beatmapSetID;
+		if (map.md5Hash != null && !map.md5Hash.isEmpty())
+			return "m:" + map.md5Hash;
+		if (map.getFile() != null && map.getFile().getParentFile() != null)
+			return "p:" + map.getFile().getParentFile().getName();
+		return "t:" + map.artist + " - " + map.title;
+	}
+
+	/** Returns collection names in display order. */
+	public static synchronized String[] getNames() {
+		load();
+		return collections.keySet().toArray(new String[collections.size()]);
+	}
+
+	/** Returns whether at least one collection exists. */
+	public static synchronized boolean hasCollections() {
+		load();
+		return !collections.isEmpty();
+	}
+
+	/** Returns the selected collection name, or {@code null}. */
+	public static synchronized String getSelectedName() {
+		load();
+		return selectedName;
+	}
+
+	/** Selects an existing collection. */
+	public static synchronized boolean select(String name) {
+		load();
+		String canonical = findCanonicalName(name);
+		if (canonical == null)
+			return false;
+		selectedName = canonical;
+		return save();
+	}
+
+	/** Creates and selects a collection. */
+	public static synchronized boolean create(String name) {
+		load();
+		name = cleanName(name);
+		if (name.isEmpty() || collections.size() >= MAX_COLLECTIONS || findCanonicalName(name) != null)
+			return false;
+		collections.put(name, new LinkedHashSet<String>());
+		selectedName = name;
+		return save();
+	}
+
+	/** Deletes a collection. */
+	public static synchronized boolean delete(String name) {
+		load();
+		String canonical = findCanonicalName(name);
+		if (canonical == null)
+			return false;
+		collections.remove(canonical);
+		if (canonical.equals(selectedName))
+			selectedName = collections.isEmpty() ? null : collections.keySet().iterator().next();
+		return save();
+	}
+
+	/** Returns whether a set is in a collection. */
+	public static synchronized boolean contains(String name, BeatmapSet set) {
+		load();
+		String canonical = findCanonicalName(name);
+		return canonical != null && collections.get(canonical).contains(getSetKey(set));
+	}
+
+	/** Adds a beatmap set to a collection. */
+	public static synchronized boolean add(String name, BeatmapSet set) {
+		load();
+		String canonical = findCanonicalName(name);
+		String key = getSetKey(set);
+		if (canonical == null || key.isEmpty())
+			return false;
+		if (!collections.get(canonical).add(key))
+			return true;
+		return save();
+	}
+
+	/** Removes a beatmap set from a collection. */
+	public static synchronized boolean remove(String name, BeatmapSet set) {
+		load();
+		String canonical = findCanonicalName(name);
+		if (canonical == null)
+			return false;
+		if (!collections.get(canonical).remove(getSetKey(set)))
+			return true;
+		return save();
+	}
+
+	/** Returns the number of maps in a collection. */
+	public static synchronized int size(String name) {
+		load();
+		String canonical = findCanonicalName(name);
+		return (canonical == null) ? 0 : collections.get(canonical).size();
+	}
+
+	/** Filters parsed nodes to the selected collection. */
+	public static synchronized ArrayList<BeatmapSetNode> filter(ArrayList<BeatmapSetNode> list) {
+		load();
+		ArrayList<BeatmapSetNode> filtered = new ArrayList<BeatmapSetNode>();
+		String canonical = findCanonicalName(selectedName);
+		if (canonical == null)
+			return filtered;
+		LinkedHashSet<String> keys = collections.get(canonical);
+		for (BeatmapSetNode node : list) {
+			if (keys.contains(getSetKey(node.getBeatmapSet())))
+				filtered.add(node);
+		}
+		return filtered;
+	}
+}
